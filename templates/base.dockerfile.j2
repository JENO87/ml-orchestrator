{# templates/base.dockerfile.j2 #}
# This is the base template for all Dockerfiles in this project.

# === Stage 1: Builder ===
FROM python:3.11-bullseye AS builder

WORKDIR /app

# Install uv, the fast Python package installer.
RUN pip install uv

# Create and activate a virtual environment.
ENV VIRTUAL_ENV=/app/.venv
RUN python -m venv $VIRTUAL_ENV
ENV PATH="$VIRTUAL_ENV/bin:$PATH"

# Copy only the dependency definition file first to leverage Docker caching.
COPY pyproject.toml ./

# Install dependencies from pyproject.toml into the virtual environment.
# The '.' tells uv to install from the current directory's pyproject.toml.
RUN uv pip install .

# === Stage 2: Final Image ===
FROM python:3.11-slim-bullseye AS final

WORKDIR /app

RUN groupadd --system nonroot && \
    useradd --system --gid nonroot nonroot

COPY --from=builder /app/.venv ./.venv

# --- Start of overridable block for source code ---
{% block source_code %}
# By default, copy the entire src directory.
# A child template can override this to copy specific files.
COPY src/ /app/src
{% endblock source_code %}
# --- End of overridable block ---

ENV PATH="/app/.venv:$PATH"

USER nonroot

# --- Start of overridable block for the command ---
{% block command %}
# Default command, can be overridden by child templates.
CMD ["python", "--version"]
{% endblock command %}
# --- End of overridable block ---
